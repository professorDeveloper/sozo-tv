*.iml
.gradle
/local.properties
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Release signing — never committed.
key.properties
*.jks
*.keystore

# Sozo Glass design-system working docs (generated)
/.glass-spec

# Internal docs — audits, plans, notes. This repository is public; these stay
# on the developer's machine and are never published.
/docs/

# Native Apple TV generated project, build artifacts and distribution secrets.
/apple-tv/build/
/apple-tv/SozoTV.xcodeproj/
*.xcarchive
*.xcresult
*.ipa
*.p12
*.mobileprovision
AuthKey_*.p8

# Build output, IDE state and stray working files. The release APK is built by
# CI (release.yml); nothing under app/release/ belongs in the repository.
/app/release/
*.apk
*.aab
!**/src/test/resources/**/*.apk
# The shared code style stays tracked; the rest of .idea is per-machine.
/.idea/*
!/.idea/codeStyles/
.idea_backup/
/*.srt
