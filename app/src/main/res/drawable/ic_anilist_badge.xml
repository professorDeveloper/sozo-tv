<?xml version="1.0" encoding="utf-8"?>
<!--
  The logo on a rounded tile for the profile rail. The official artwork is a
  square, so the corners are rounded here rather than by editing the mark.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="#1E2630" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:drawable="@drawable/ic_anilist_logo" />
</layer-list>
