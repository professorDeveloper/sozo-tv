<?xml version="1.0" encoding="utf-8"?>
<!--
  A confirm dialog is a question and two answers. This one had a faded title
  with a stray space before its "!", an 80dp trash icon in its own row, and the
  whole question boxed inside a 330dp panel wearing the QR-code background —
  three nested containers to ask one thing. It is now the icon, the question,
  and the two buttons, with the safe answer focused first.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="@color/netflix_background_primary"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            app:srcCompat="@drawable/delete_all"
            app:tint="@color/red" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/days"
            android:gravity="center"
            android:text="@string/history_clear_title"
            android:textColor="@color/lb_tv_white"
            android:textSize="@dimen/tv_text_subtitle" />

        <TextView
            android:id="@+id/continueTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/rubik_regular"
            android:gravity="center"
            android:text="@string/clear_history_confirm"
            android:textColor="@color/lb_grey"
            android:textSize="@dimen/tv_text_body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <!--
              Focused first, and it is the one that changes nothing. A remote
              user confirming a destructive dialog by reflex should land on the
              way out, not on the delete.
            -->
            <LinearLayout
                android:id="@+id/keepBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/background_button"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:orientation="horizontal">

                <requestFocus />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="@font/days"
                    android:paddingVertical="13dp"
                    android:text="@string/history_clear_keep"
                    android:textAlignment="center"
                    android:textColor="@color/color_item_tv_category_tv"
                    android:textSize="@dimen/tv_text_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/clearBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/background_button_login"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="@font/days"
                    android:paddingVertical="13dp"
                    android:text="@string/history_clear_confirm_btn"
                    android:textAlignment="center"
                    android:textColor="@color/color_item_tv_category_tv"
                    android:textSize="@dimen/tv_text_label"
                    tools:ignore="TextContrastCheck" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
