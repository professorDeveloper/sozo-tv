<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_exo_controller_tv"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/bottom_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/glass_scrim_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.45"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/top_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/glass_scrim_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.28"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/frameBackButton"
        android:contentDescription="@string/player_hint_back"
        style="@style/PlayerGlassButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/player_edge_horizontal"
        android:layout_marginTop="28dp"
        android:nextFocusRight="@id/epListContainer"
        android:nextFocusDown="@id/exo_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            style="@style/PlayerGlassButtonIcon"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_arrow_left" />
    </FrameLayout>

    <TextView
        android:id="@+id/film_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:fontFamily="@font/days"
        android:maxLines="1"
        android:shadowColor="#99000000"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:textColor="@color/netflix_white"
        android:textSize="@dimen/tv_text_screen_title"
        app:layout_constraintEnd_toStartOf="@+id/epListContainer"
        app:layout_constraintStart_toEndOf="@+id/frameBackButton"
        app:layout_constraintTop_toTopOf="@+id/frameBackButton"
        app:layout_goneMarginEnd="@dimen/player_edge_horizontal"
        tools:text="Attack on Titan — The Final Season" />

    <TextView
        android:id="@+id/episode_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/glass_pill_bg"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:maxWidth="420dp"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:textColor="@color/netflix_white"
        android:textSize="@dimen/tv_text_body"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/film_title"
        app:layout_constraintTop_toBottomOf="@id/film_title"
        tools:text="Episode 5 · 1080p"
        tools:visibility="visible" />

    <FrameLayout
        android:id="@+id/epListContainer"
        android:contentDescription="@string/player_hint_episodes"
        style="@style/PlayerGlassButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="@dimen/player_edge_horizontal"
        android:nextFocusLeft="@id/frameBackButton"
        android:nextFocusDown="@id/exo_progress"
        app:layout_constraintBottom_toBottomOf="@id/frameBackButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/frameBackButton">

        <androidx.appcompat.widget.AppCompatImageView
            style="@style/PlayerGlassButtonIcon"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_more_list" />
    </FrameLayout>

    <TextView
        android:id="@+id/control_hint"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/glass_pill_bg"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:maxWidth="260dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#E6FFFFFF"
        android:textSize="@dimen/tv_text_caption"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel"
        app:layout_constraintEnd_toEndOf="@id/bottom_panel"
        app:layout_constraintStart_toStartOf="@id/bottom_panel"
        tools:text="Subtitles"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/player_edge_horizontal"
        android:layout_marginEnd="@dimen/player_edge_horizontal"
        android:layout_marginBottom="@dimen/player_edge_vertical"
        android:background="@drawable/glass_panel_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="14dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/exo_thumbnail"
                android:layout_width="160dp"
                android:layout_height="90dp"
                android:layout_marginBottom="8dp"
                android:background="#33FFFFFF"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                app:strokeColor="#66FFFFFF"
                app:strokeWidth="1dp"
                tools:src="@drawable/gradient_back"
                tools:visibility="visible" />

            <view
                android:id="@id/exo_progress"
                class="com.saikou.sozo_tv.presentation.screens.play.TrailerPlayerScreen$ExtendedTimeBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/frameBackButton"
                android:nextFocusDown="@id/exo_play_pause_container"
                app:ad_marker_color="#E6FFFFFF"
                app:ad_marker_width="4dp"
                app:bar_height="5dp"
                app:buffered_color="#CCFFFFFF"
                app:played_ad_marker_color="#4DFFFFFF"
                app:played_color="@color/netflix_red"
                app:scrubber_color="@color/netflix_white"
                app:scrubber_dragged_size="26dp"
                app:scrubber_enabled_size="13dp"
                app:touch_target_height="32dp"
                app:unplayed_color="#26FFFFFF" />
        </LinearLayout>

        <FrameLayout
            android:id="@id/exo_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="4dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@id/exo_position"
                    style="@style/PlayerTimeText"
                    android:textColor="@color/netflix_white"
                    tools:text="00:12:40" />

                <TextView
                    android:id="@+id/tv_time_separator"
                    style="@style/PlayerTimeText"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="/"
                    android:textColor="#80FFFFFF"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@id/exo_duration"
                    style="@style/PlayerTimeText"
                    android:textColor="#B3FFFFFF"
                    tools:text="00:24:10" />

                <TextView
                    android:id="@+id/exo_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/glass_pill_bg"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="@dimen/tv_text_caption"
                    android:visibility="gone"
                    tools:text="−11:30"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/exo_prev_container"
        android:contentDescription="@string/player_hint_prev_episode"
                    style="@style/PlayerGlassButton"
                    android:layout_marginEnd="10dp"
                    android:nextFocusLeft="@id/exo_prev_container"
                    android:nextFocusUp="@id/exo_progress">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/exo_prev_"
                        style="@style/PlayerGlassButtonIcon"
                        app:srcCompat="@drawable/ic_player_skip_prev" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/exo_prev_ten_container"
        android:contentDescription="@string/player_hint_rewind"
                    style="@style/PlayerGlassButton"
                    android:nextFocusUp="@id/exo_progress">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/exo_prev_ten"
                        style="@style/PlayerGlassButtonIcon"
                        app:srcCompat="@drawable/ic_player_replay_10" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/exo_play_pause_container"
        android:contentDescription="@string/player_hint_play"
                    style="@style/PlayerGlassButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:focusedByDefault="true"
                    android:nextFocusUp="@id/exo_progress">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/exo_play_paused"
                        style="@style/PlayerGlassButtonIcon"
                        android:padding="14dp"
                        app:srcCompat="@drawable/ic_player_play" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/exo_next_ten_container"
        android:contentDescription="@string/player_hint_forward"
                    style="@style/PlayerGlassButton"
                    android:nextFocusUp="@id/exo_progress">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/exo_nex_ten"
                        style="@style/PlayerGlassButtonIcon"
                        app:srcCompat="@drawable/ic_player_forward_10" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/exo_next_container"
        android:contentDescription="@string/player_hint_next_episode"
                    style="@style/PlayerGlassButton"
                    android:layout_marginStart="10dp"
                    android:nextFocusUp="@id/exo_progress">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/exo_next_"
                        style="@style/PlayerGlassButtonIcon"
                        app:srcCompat="@drawable/ic_player_skip_next" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/exo_server"
                    style="@style/PlayerGlassButton"
                    android:layout_marginEnd="8dp"
                    android:nextFocusUp="@id/exo_progress"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/PlayerGlassButtonIcon"
                        app:srcCompat="@drawable/ic_round_star_24" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/exo_quality"
                    style="@style/PlayerGlassButton"
                    android:layout_marginEnd="8dp"
                    android:nextFocusUp="@id/exo_progress"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/PlayerGlassButtonIcon"
                        app:srcCompat="@drawable/ic_hd_movie" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/exo_audio"
        android:contentDescription="@string/player_hint_audio"
                    style="@style/PlayerGlassButton"
                    android:layout_marginEnd="8dp"
                    android:nextFocusUp="@id/exo_progress"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/PlayerGlassButtonIcon"
                        app:srcCompat="@drawable/ic_audio_track" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/exo_subtidtle"
        android:contentDescription="@string/player_hint_subtitles"
                    style="@style/PlayerGlassButton"
                    android:layout_marginEnd="8dp"
                    android:nextFocusUp="@id/exo_progress">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/exo_subtitlee"
                        style="@style/PlayerGlassButtonIcon"
                        app:srcCompat="@drawable/ic_player_subtitles" />
                </FrameLayout>

                <FrameLayout
                    android:id="@id/exo_settings"
        android:contentDescription="@string/player_hint_settings"
                    style="@style/PlayerGlassButton"
                    android:nextFocusRight="@id/exo_settings"
                    android:nextFocusUp="@id/exo_progress">

                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/PlayerGlassButtonIcon"
                        app:srcCompat="@drawable/ic_settings" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
