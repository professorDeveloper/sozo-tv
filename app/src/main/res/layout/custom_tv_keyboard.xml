<?xml version="1.0" encoding="utf-8"?>
<!--
  TV search keyboard — QWERTY with a symbols page.

  SIZING IS LOAD-BEARING. The keyboard column is layout_weight 1.2 of a 2.9 row
  on a 960dp-wide panel = ~397dp, minus 32dp padding = ~365dp usable. Ten
  columns at 32+2dp = 340dp plus 8dp root padding fits with room to spare.
  An earlier 36dp/2dp version needed 408dp and was visibly cut off at the 7th
  key — re-check this arithmetic before changing key size or the column weight.

  Letter/digit keys keep their @id/key_<char> names so the id-based wiring in
  CustomTVKeyboard.kt is untouched. Symbol keys carry NO id: they are bound by
  walking the container and reading each key's own text, so adding a symbol
  needs no Kotlin change.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
