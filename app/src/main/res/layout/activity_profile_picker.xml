<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/netflix_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="56dp"
        android:paddingVertical="34dp">

        <ImageView
            android:layout_width="112dp"
            android:layout_height="42dp"
            android:contentDescription="@string/app_name"
            android:scaleType="centerInside"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/profile_who_is_watching"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/profile_picker_hint"
            android:textColor="@color/netflix_gray"
            android:textSize="16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profiles"
            android:layout_width="wrap_content"
            android:layout_height="204dp"
            android:layout_marginTop="28dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="10dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/addProfile"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/profile_button_focus"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:text="@string/profile_add"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/manageProfiles"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/profile_button_focus"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:text="@string/profile_manage"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/red"
            android:visibility="gone" />

        <TextView
            android:id="@+id/error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/red"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
