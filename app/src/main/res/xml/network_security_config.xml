<?xml version="1.0" encoding="utf-8"?>
<!--
  Sources are added by the user at runtime from remote repos, so their hosts are
  not knowable at build time. This file used to allow cleartext for a hardcoded
  list of ~40 domains, which silently denied every other one: once a network
  security config exists, android:usesCleartextTraffic is ignored and the
  unlisted default on targetSdk 28+ is deny. Any http:// source added later
  failed with UnknownServiceException.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
